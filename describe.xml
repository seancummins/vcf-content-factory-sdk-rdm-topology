<?xml version="1.0" encoding="UTF-8"?>
<AdapterKind xmlns="http://schemas.vmware.com/vcops/schema"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             key="vcfcf_rdm_topology_poc"
             nameKey="1"
             version="1"
             xsi:schemaLocation="http://schemas.vmware.com/vcops/schema describeSchema.xsd">
  <ResourceKinds>
    <!-- Fixture-only adapter instance. It has no endpoint or credentials. -->
    <ResourceKind key="vcfcf_rdm_topology_poc" nameKey="2" type="7"
                  isCredentialRequired="false" monitoringInterval="5"/>

    <!-- Identity is deliberately limited to the stable RDM tuple. -->
    <ResourceKind key="RdmMapping" nameKey="10" type="1">
      <ResourceIdentifier key="vcenter_instance_uuid" nameKey="11"
                          type="string" required="true" dispOrder="1"/>
      <ResourceIdentifier key="vm_instance_uuid" nameKey="12"
                          type="string" required="true" dispOrder="2"/>
      <ResourceIdentifier key="virtual_disk_key" nameKey="13"
                          type="string" required="true" dispOrder="3"/>
    </ResourceKind>
  </ResourceKinds>
  <LicenseConfig enabled="false"/>
</AdapterKind>
