<?xml version="1.0" encoding="UTF-8"?>
<AdapterKind xmlns="http://schemas.vmware.com/vcops/schema"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             key="vcfcf_rdm_topology_poc"
             nameKey="1"
             version="1"
             xsi:schemaLocation="http://schemas.vmware.com/vcops/schema describeSchema.xsd">
  <CredentialKinds>
    <CredentialKind key="rdm_vcenter_readonly" nameKey="40">
      <CredentialField key="username" nameKey="41" type="string" required="true" dispOrder="1"/>
      <CredentialField key="password" nameKey="42" type="string" required="true" password="true" dispOrder="2"/>
    </CredentialKind>
  </CredentialKinds>
  <ResourceKinds>
    <!-- All settings are conditionally required by the selected runtime route. -->
    <ResourceKind key="vcfcf_rdm_topology_poc" nameKey="2" type="7"
                  credentialKind="rdm_vcenter_readonly" isCredentialRequired="false" monitoringInterval="5">
      <!-- Ordinary persisted instance setting, never part of account identity. -->
      <ResourceIdentifier key="fixture_json" nameKey="3" type="string"
                          required="false" dispOrder="1" identType="2"/>
      <ResourceIdentifier key="execution_mode" nameKey="43" type="string" required="false" dispOrder="2" identType="2"/>
      <ResourceIdentifier key="vcenter_endpoint" nameKey="44" type="string" required="false" dispOrder="3" identType="2"/>
      <ResourceIdentifier key="trust_mode" nameKey="45" type="string" required="false" dispOrder="4" identType="2"/>
      <ResourceIdentifier key="discovery_scope" nameKey="46" type="string" required="false" dispOrder="5" identType="2"/>
      <ResourceIdentifier key="ops_endpoint" nameKey="47" type="string" required="false" dispOrder="6" identType="2"/>
      <ResourceIdentifier key="ops_trust_mode" nameKey="48" type="string" required="false" dispOrder="7" identType="2"/>
      <ResourceIdentifier key="target_vcenter_uuid" nameKey="49" type="string" required="false" dispOrder="8" identType="2"/>
      <ResourceIdentifier key="target_vm_moid" nameKey="50" type="string" required="false" dispOrder="9" identType="2"/>
      <ResourceIdentifier key="target_disk_key" nameKey="51" type="string" required="false" dispOrder="10" identType="2"/>
      <ResourceIdentifier key="diagnostic_enabled" nameKey="52" type="string" required="false" dispOrder="11" identType="2"/>
      <ResourceIdentifier key="authorize_once" nameKey="53" type="string" required="false" dispOrder="12" identType="2"/>
    </ResourceKind>

    <!-- Identity is deliberately limited to the stable RDM tuple. -->
    <ResourceKind key="RdmMapping" nameKey="10" type="1">
      <ResourceIdentifier key="vcenter_instance_uuid" nameKey="11"
                          type="string" required="true" dispOrder="1"/>
      <ResourceIdentifier key="vm_instance_uuid" nameKey="12"
                          type="string" required="true" dispOrder="2"/>
      <ResourceIdentifier key="virtual_disk_key" nameKey="13"
                          type="string" required="true" dispOrder="3"/>
    </ResourceKind>
    <ResourceKind key="CanonicalLun" nameKey="20" type="1">
      <ResourceIdentifier key="identity_token" nameKey="21" type="string" required="true" dispOrder="1"/>
      <!-- Composite MetricKeys are group|leaf; individual describe keys cannot contain | or :. -->
      <ResourceGroup key="identity" nameKey="33" instanced="false">
        <ResourceAttribute key="format" nameKey="22" dataType="string" isProperty="true"/>
        <ResourceAttribute key="canonical_name" nameKey="23" dataType="string" isProperty="true"/>
        <ResourceAttribute key="provenance" nameKey="24" dataType="string" isProperty="true"/>
        <ResourceAttribute key="assessment" nameKey="25" dataType="string" isProperty="true"/>
      </ResourceGroup>
      <ResourceGroup key="storage" nameKey="34" instanced="false">
        <ResourceAttribute key="vendor" nameKey="26" dataType="string" isProperty="true"/>
        <ResourceAttribute key="model" nameKey="27" dataType="string" isProperty="true"/>
        <ResourceAttribute key="revision" nameKey="28" dataType="string" isProperty="true"/>
        <ResourceAttribute key="serial_number" nameKey="29" dataType="string" isProperty="true"/>
        <ResourceAttribute key="lun_type" nameKey="30" dataType="string" isProperty="true"/>
        <ResourceAttribute key="device_type" nameKey="31" dataType="string" isProperty="true"/>
        <ResourceAttribute key="capacity_bytes" nameKey="32" dataType="string" isProperty="true"/>
      </ResourceGroup>
    </ResourceKind>
  </ResourceKinds>
  <LicenseConfig enabled="false"/>
</AdapterKind>
